# PostgreSQL container (docker compose)
# Used by the db service and to build DATABASE_URL for the backend container.
POSTGRES_DB=learn_ai_engineering
POSTGRES_USER=learn
POSTGRES_PASSWORD=learn

# Database (backend)
# Compose default uses the db service hostname. For local dev outside Docker, use localhost:
# postgres://learn:learn@localhost:5432/learn_ai_engineering?sslmode=disable
DATABASE_URL=postgres://learn:learn@db:5432/learn_ai_engineering?sslmode=disable

# Test database (used by integration tests: go test -tags=integration ./...)
# Run `docker compose up -d db` and point this at an isolated test database, never dev.
TEST_DATABASE_URL=postgres://learn:learn@localhost:5432/learn_ai_engineering_test?sslmode=disable

# Server (backend)
HOST=0.0.0.0
PORT=8080

# Static frontend build (backend). Optional: when set, the backend serves this
# directory, the SPA fallback and the API under /api. The root Dockerfile sets /app/static.
# STATIC_DIR=/app/static

# Environment (backend)
ENV=development

# Seed: maintainer account (created/ensured by seed when both are set; no UI to assign this flag)
SEED_MAINTAINER_EMAIL=maintainer@example.com
SEED_MAINTAINER_PASSWORD=change-me-in-dev

# Frontend (Vite): API client selection and base URL
# VITE_API_MODE=mock selects the in-memory mock; VITE_API_MODE=http uses the backend.
# The frontend container image is built with VITE_API_MODE=http and VITE_API_BASE_URL=/api.
# For local Vite dev with the proxy, use /api so requests stay same-origin.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# Frontend container: upstream API address (host:port) for /api proxy. Default: backend:8080
API_UPSTREAM=backend:8080
