# Database
DATABASE_URL=postgres://user:password@localhost:5432/learn_ai_engineering?sslmode=disable

# Test database (used by integration tests: go test -tags=integration ./...)
TEST_DATABASE_URL=postgres://user:password@localhost:5432/learn_ai_engineering_test?sslmode=disable

# Server
HOST=0.0.0.0
PORT=8080

# Environment
ENV=development

# Seed: maintainer account (created/ensured by seed when both are set; no UI to assign this flag)
SEED_MAINTAINER_EMAIL=maintainer@example.com
SEED_MAINTAINER_PASSWORD=change-me-in-dev

# Frontend (Vite): API client selection and base URL
# VITE_API_MODE=mock selects the in-memory mock; VITE_API_MODE=http uses the backend.
# Production builds always use http. VITE_API_BASE_URL is the only base-URL source.
# In development with the Vite proxy, use /api so requests stay same-origin.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
