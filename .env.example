# PostgreSQL container (docker compose)
# Used by the db service and to build DATABASE_URL for the backend container.
POSTGRES_DB=learn_ai_engineering
POSTGRES_USER=learn
POSTGRES_PASSWORD=learn

# Database (backend)
# Compose default uses the db service hostname. For local dev outside Docker, use localhost:
# postgres://learn:learn@localhost:5432/learn_ai_engineering?sslmode=disable
DATABASE_URL=postgres://learn:learn@db:5432/learn_ai_engineering?sslmode=disable

# Test database (used by integration tests: go test -tags=integration ./...)
# Run `docker compose up -d db` and point this at an isolated test database, never dev.
TEST_DATABASE_URL=postgres://learn:learn@localhost:5432/learn_ai_engineering_test?sslmode=disable

# Server (backend)
HOST=0.0.0.0
PORT=8080

# Static frontend build (backend). Optional: when set, the backend serves this
# directory, the SPA fallback and the API under /api. The root Dockerfile sets /app/static.
# STATIC_DIR=/app/static

# Environment (backend)
ENV=development

# Seed: maintainer account (created/ensured by seed when both are set; no UI to assign this flag)
SEED_MAINTAINER_EMAIL=maintainer@example.com
SEED_MAINTAINER_PASSWORD=change-me-in-dev

# Frontend (Vite): API client selection and base URL
# VITE_API_MODE=mock selects the in-memory mock; VITE_API_MODE=http uses the backend.
# The frontend container image is built with VITE_API_MODE=http and VITE_API_BASE_URL=/api.
# For local Vite dev with the proxy, use /api so requests stay same-origin.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# Frontend container: upstream API address (host:port) for /api proxy. Default: backend:8080
API_UPSTREAM=backend:8080

# Observability (backend, optional). When OTEL_EXPORTER_OTLP_ENDPOINT is unset,
# telemetry is a no-op and the API starts and behaves the same. Standard OTEL_*
# variables are supported.
OTEL_SERVICE_NAME=learn-ai-engineering-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Observability (local alerting, optional). Webhook that receives quiz submission
# 5xx alerts from Alertmanager when the observability profile runs. No secret.
# By default the observability profile delivers alerts to the local receiver service.
ALERT_WEBHOOK_URL=http://receiver:8081/alerts

# Observability (local on-call receiver, optional). Used only by the receiver in
# the local observability drill. The provider, model and API key come from
# environment variables only; never commit them or put them in prompts, logs or
# incident bundles. When the key is missing the receiver stores the incident but
# fails fast with a clear message and starts no agent.
OPENCODE_PROVIDER=
OPENCODE_MODEL=
OPENCODE_API_KEY=
# Provider-specific equivalents may be used instead of OPENCODE_API_KEY (for
# example OPENAI_API_KEY or ANTHROPIC_API_KEY), as documented by the provider.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
INCIDENT_BUNDLE_DIR=/data/incidents
REPO_DIR=/data/repo
REPO_SRC=/repo-src
OPENCODE_BIN=opencode


# Observability (local integration testing only). Test-only fault injection for
# POST /topics/{topicSlug}/quiz/submissions used by
# observability/alert-integration-check.sh to produce deterministic 5xx responses.
# Disabled by default. Startup enables it only when ENV=test and rejects attempts
# to enable it in development/production; it cannot be enabled in the deployed
# Render environment. Not a runtime/public control.
# FAULT_INJECT_QUIZ_SUBMISSION_5XX=true

