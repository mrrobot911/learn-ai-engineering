{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    // Written in full (with type) so it also applies on OpenCode 2, which ignores enabled-only entries.
    "gopls": { "type": "local", "command": ["gopls", "mcp"], "enabled": true },
    // The global nixos MCP is for NixOS repositories only; off in this project.
    "nixos": { "type": "local", "command": ["mcp-nixos"], "enabled": false }
  },

  "permission": {
    "bash": {
      "npm*": "deny",
      "npx*": "deny",
      "yarn*": "deny",
      "pnpm*": "deny",

      "gh workflow run*": "ask",
      "git push origin main*": "ask"
    }
  }
}
